{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "lightrag",
        "namespace": "prod"
      },
      "spec": {
        "selector": {
          "lightrag.io/deployment": "lightrag_prod",
          "lightrag.io/slot": "blue"
        },
        "ports": [
          {
            "name": "http",
            "port": 9621,
            "targetPort": 9621
          }
        ],
        "type": "NodePort"
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "lightrag",
        "namespace": "prod",
        "annotations": {
          "kubernetes.io/ingress.class": "qcloud",
          "kubernetes.io/ingress.existLbId": "lb-ao2qcdid",
          "ingress.cloud.tencent.com/enable-group": "true"
        }
      },
      "spec": {
        "ingressClassName": "qcloud",
        "rules": [
          {
            "host": "llm-rag.eplus2.cn",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "lightrag",
                      "port": {
                        "number": 9621
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
